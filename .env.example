# Runtime database. MySQL 8.0+ only; no SQLite fallback is supported.
DATABASE_URL=mysql+asyncmy://game_user:change_me@127.0.0.1:3306/deviation_protocol?charset=utf8mb4

# Optional disposable MySQL database used only by integration tests.
TEST_DATABASE_URL=mysql+asyncmy://game_test_user:change_me@127.0.0.1:3306/deviation_protocol_test?charset=utf8mb4

# Optional Phase 2.2b-1 DeepSeek narrative adapter. Keep the key empty in this file.
# Runtime code reads process environment only and never loads .env itself.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_MAX_RETRIES=0

# Live smoke remains off unless this is explicitly set to 1 in the test process.
RUN_LIVE_DEEPSEEK_TEST=0
